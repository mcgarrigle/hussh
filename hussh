#!/usr/bin/env python3

import os
import logging
import paramiko

from lib.hussh import HUSSH

logging.basicConfig()
paramiko.util.log_to_file('logs/hussh.log', level='INFO')

def main():
    home = os.path.dirname(os.path.realpath(__file__))
    hussh = HUSSH(home)
    hussh.listen()

if __name__ == '__main__':
    main()
